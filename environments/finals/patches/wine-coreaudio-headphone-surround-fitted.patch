 static float binaural_sample(const struct binaural *b, const BYTE *frame, UINT c)
 {
     switch(b->bytes){
     case 2: return ((const INT16 *)frame)[c] / 32768.0f;
     case 3:
     {
         const BYTE *s = frame + 3 * c;
         return (INT32)(((UINT32)s[0] << 8) | ((UINT32)s[1] << 16) | ((UINT32)s[2] << 24)) / 2147483648.0f;
     }
     case 4: return b->is_float ? ((const float *)frame)[c] : ((const INT32 *)frame)[c] / 2147483648.0f;
     }
     return 0;
 }
 
