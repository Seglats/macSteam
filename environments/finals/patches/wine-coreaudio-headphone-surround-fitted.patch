+/* A 48 kHz filter at the stream's rate (windowed sinc, band-limited below 48 kHz), reversed. */
+static void binaural_resample(const float *h, float *out, int taps, float rate)
+{
+    float ratio = SURROUND_IR_RATE / rate, fc = rate < SURROUND_IR_RATE ? rate / SURROUND_IR_RATE : 1.0f;
