+            sum += h[k] * (x == 0 ? 1.0f : sinf((float)M_PI * x) / ((float)M_PI * x)) * (0.5f + 0.5f * cosf((float)M_PI * x / 16))
+                   * ratio * fc;
+        }
+        out[taps - 1 - n] = sum;
+    }
