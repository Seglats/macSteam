 }
 
 static enum surround_pos binaural_position(DWORD bit, DWORD mask)
 {
     BOOL sides = (mask & (SPEAKER_SIDE_LEFT | SPEAKER_SIDE_RIGHT)) != 0;
     BOOL backs = (mask & (SPEAKER_BACK_LEFT | SPEAKER_BACK_RIGHT)) != 0;
 
     /* with only one pair of surrounds (5.1), they sit at 110 degrees */
     switch(bit){
     case SPEAKER_FRONT_LEFT: case SPEAKER_TOP_FRONT_LEFT: return SURROUND_FL;
     case SPEAKER_FRONT_RIGHT: case SPEAKER_TOP_FRONT_RIGHT: return SURROUND_FR;
     case SPEAKER_FRONT_LEFT_OF_CENTER: return SURROUND_FLC;
     case SPEAKER_FRONT_RIGHT_OF_CENTER: return SURROUND_FRC;
     case SPEAKER_BACK_LEFT: case SPEAKER_TOP_BACK_LEFT: return sides ? SURROUND_BL : SURROUND_S5L;
     case SPEAKER_BACK_RIGHT: case SPEAKER_TOP_BACK_RIGHT: return sides ? SURROUND_BR : SURROUND_S5R;
     case SPEAKER_BACK_CENTER: case SPEAKER_TOP_BACK_CENTER: return SURROUND_BC;
     case SPEAKER_SIDE_LEFT: return backs ? SURROUND_SL : SURROUND_S5L;
     case SPEAKER_SIDE_RIGHT: return backs ? SURROUND_SR : SURROUND_S5R;
     }
     return SURROUND_C;   /* front center, top center, top front center, unlisted channels */
 }
 
 /* A 48 kHz filter at the stream's rate (windowed sinc, band-limited below 48 kHz), reversed. */
 static void binaural_resample(const float *h, float *out, int taps, float rate)
 {
     float ratio = SURROUND_IR_RATE / rate, fc = rate < SURROUND_IR_RATE ? rate / SURROUND_IR_RATE : 1.0f;
     int n, k;
 
     for(n = 0; n < taps; n++){
         float t = n * ratio, sum = 0;
         if(ratio == 1.0f) sum = n < SURROUND_IR_TAPS ? h[n] : 0;
         else for(k = 0; k < SURROUND_IR_TAPS; k++){
             float x = fc * (t - k);
             if(fabsf(x) >= 16) continue;
             sum += h[k] * (x == 0 ? 1.0f : sinf((float)M_PI * x) / ((float)M_PI * x)) * (0.5f + 0.5f * cosf((float)M_PI * x / 16))
                    * ratio * fc;
         }
         out[taps - 1 - n] = sum;
     }
 }
 
 static void binaural_free(struct binaural *b)
 {
     int i, e;
 
     if(!b) return;
     for(i = 0; i < SURROUND_POSITIONS; i++)
         for(e = 0; e < 2; e++) free(b->ir[i][e]);
     for(i = 0; i < BIN_FDN; i++) free(b->fdn[i]);
     free(b);
 }
 
