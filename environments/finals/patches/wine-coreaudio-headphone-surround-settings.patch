 /* Headphone surround (WINE_HEADPHONE_SURROUND=1): a stereo output device is offered to
  * Windows programs as 7.1, and each speaker channel of a multichannel stream is rendered for
  * the two ears through measured head responses: MIT's KEMAR (Bill Gardner and Keith Martin,
  * MIT Media Lab, 1994), reshaped with settings fitted to a reference headphone renderer
  * (SteamDriver's scripts/surround_fit and docs/SURROUND.md). surround_ir.h holds each speaker
  * position's finished filter per ear at 48 kHz, resampled to the stream's rate; a short, quiet
  * reverb tail (a four-line feedback delay network) follows. The audio unit then gets plain
  * stereo float, so macOS does no downmix of its own. Off unless set. */
 #include "surround_ir.h"
 
 #define BIN_MAX_CHANNELS 18
 #define BIN_MAX_TAPS (SURROUND_IR_TAPS * 4 + 8)  /* the filters at up to 192 kHz */
 #define BIN_HIST 2048           /* input history per channel (power of two): a filter and the tail's start */
 #define BIN_FDN 4
 
 struct binaural_chan
 {
     BOOL lfe;
     enum surround_pos pos;
     float gain;
 };
 
 struct binaural
 {
     UINT channels, bytes;
     BOOL is_float;
     UINT pos;
     int taps, tail_delay;
     struct binaural_chan ch[BIN_MAX_CHANNELS];
     float *ir[SURROUND_POSITIONS][2];       /* reversed, at the stream's rate; NULL when unused */
     float hist[BIN_MAX_CHANNELS][2 * BIN_HIST]; /* each sample written twice, so reads never wrap */
     float *fdn[BIN_FDN];
     int fdn_len[BIN_FDN], fdn_pos[BIN_FDN];
     float fdn_damp[BIN_FDN], fdn_g, fdn_k;
+    float tail_level;
 };
 
+/* Settings baked by macSteam (Experimental › Headphone surround › Settings…, its live preview's
+ * Save): WINE_HEADPHONE_SURROUND_FILTERS names the file, which SteamDriver's run script passes on
+ * when there is one. Same filters, gains and tail as surround_ir.h, from the player's own knobs:
+ * "SDSURR1\0", rate, taps, positions, a gain per position, the LFE gain, the tail (level, time,
+ * damping, start), then each position's filters per ear. Read when a stream starts; anything
+ * unexpected (size, rate, taps, a value that isn't finite) and the built-in fitted filters play. */
+struct surround_baked
+{
+    float gain[SURROUND_POSITIONS], lfe, tail, tail_rt, tail_lp, tail_ms;
+    float ir[SURROUND_POSITIONS][2][SURROUND_IR_TAPS];
+};
+
+static struct surround_baked *surround_baked_load(void)
+{
+    const char *path = getenv("WINE_HEADPHONE_SURROUND_FILTERS");
+    struct surround_baked *s;
+    char magic[8];
+    unsigned int head[3], i, n;
+    FILE *f;
+    long size;
+    const float *v;
+
+    if(!path || !*path || !(f = fopen(path, "rb"))) return NULL;
+    fseek(f, 0, SEEK_END);
+    size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if(size != (long)(sizeof(magic) + sizeof(head) + sizeof(struct surround_baked)) ||
+       fread(magic, 1, sizeof(magic), f) != sizeof(magic) || memcmp(magic, "SDSURR1", 8) ||
+       fread(head, sizeof(head[0]), 3, f) != 3 ||
+       head[0] != SURROUND_IR_RATE || head[1] != SURROUND_IR_TAPS || head[2] != SURROUND_POSITIONS ||
+       !(s = malloc(sizeof(*s)))){
+        WARN("headphone surround: %s isn't a settings file for this driver; the fitted filters play\n", path);
+        fclose(f);
+        return NULL;
+    }
+    n = fread(s, sizeof(*s), 1, f);
+    fclose(f);
+    for(i = 0, v = (const float *)s; n == 1 && i < sizeof(*s) / sizeof(float); i++)
+        if(!isfinite(v[i])) n = 0;
+    if(n != 1 || s->tail_rt <= 0 || s->tail_ms < 0){
+        WARN("headphone surround: %s couldn't be read; the fitted filters play\n", path);
+        free(s);
+        return NULL;
+    }
+    TRACE("headphone surround: settings from %s\n", path);
+    return s;
+}
+
 static BOOL headphone_surround(void)
 {
     static int on = -1;
     if(on < 0){
         const char *env = getenv("WINE_HEADPHONE_SURROUND");
         on = env && *env && *env != '0';
         TRACE("headphone surround %s\n", on ? "on" : "off");
     }
     return on;
 }
 
