 static float binaural_sample(const struct binaural *b, const BYTE *frame, UINT c)
 {
     switch(b->bytes){
     case 2: return ((const INT16 *)frame)[c] / 32768.0f;
     case 3:
     {
         const BYTE *s = frame + 3 * c;
         return (INT32)(((UINT32)s[0] << 8) | ((UINT32)s[1] << 16) | ((UINT32)s[2] << 24)) / 2147483648.0f;
     }
     case 4: return b->is_float ? ((const float *)frame)[c] : ((const INT32 *)frame)[c] / 2147483648.0f;
     }
     return 0;
 }
 
 /* One frame of the stream (NULL: silence) to one stereo float frame. */
 static void binaural_frame(struct binaural *b, const BYTE *frame, float *out)
 {
     float mono = 0, y[BIN_FDN], sum = 0;
     UINT c, i;
     int k;
 
     out[0] = out[1] = 0;
     b->pos = (b->pos + 1) & (BIN_HIST - 1);
     for(c = 0; c < b->channels; c++){
         struct binaural_chan *ch = &b->ch[c];
         float v = frame ? binaural_sample(b, frame, c) * ch->gain : 0;
         float l0 = 0, l1 = 0, l2 = 0, l3 = 0, r0 = 0, r1 = 0, r2 = 0, r3 = 0;
         const float *x, *h0, *h1;
 
         if(ch->lfe){
             out[0] += v;
             out[1] += v;
             continue;
         }
         b->hist[c][b->pos] = b->hist[c][b->pos + BIN_HIST] = v;
         /* the filters are stored reversed: both run forward over the last taps samples */
         x = b->hist[c] + b->pos + BIN_HIST - (b->taps - 1);
         h0 = b->ir[ch->pos][0];
         h1 = b->ir[ch->pos][1];
         for(k = 0; k + 3 < b->taps; k += 4){
             l0 += h0[k] * x[k]; l1 += h0[k + 1] * x[k + 1]; l2 += h0[k + 2] * x[k + 2]; l3 += h0[k + 3] * x[k + 3];
             r0 += h1[k] * x[k]; r1 += h1[k + 1] * x[k + 1]; r2 += h1[k + 2] * x[k + 2]; r3 += h1[k + 3] * x[k + 3];
         }
         for(; k < b->taps; k++){
             l0 += h0[k] * x[k];
             r0 += h1[k] * x[k];
         }
         out[0] += (l0 + l1) + (l2 + l3);
         out[1] += (r0 + r1) + (r2 + r3);
         mono += b->hist[c][b->pos + BIN_HIST - b->tail_delay];
     }
 
     /* tail: Householder feedback matrix, damped, decorrelated left and right outputs */
     for(i = 0; i < BIN_FDN; i++){
         y[i] = b->fdn[i][b->fdn_pos[i]];
         b->fdn_damp[i] += b->fdn_k * (y[i] - b->fdn_damp[i]);
         if(fabsf(b->fdn_damp[i]) < 1e-20f) b->fdn_damp[i] = 0;   /* no denormals once quiet */
         sum += b->fdn_damp[i];
     }
     for(i = 0; i < BIN_FDN; i++){
         b->fdn[i][b->fdn_pos[i]] = b->fdn_g * (b->fdn_damp[i] - 0.5f * sum) + 0.12f * mono;
         if(++b->fdn_pos[i] == b->fdn_len[i]) b->fdn_pos[i] = 0;
     }
-    out[0] += 0.10f * SURROUND_TAIL * (y[0] - y[2] + 0.5f * y[1]);
-    out[1] += 0.10f * SURROUND_TAIL * (y[1] - y[3] + 0.5f * y[2]);
+    out[0] += 0.10f * b->tail_level * (y[0] - y[2] + 0.5f * y[1]);
+    out[1] += 0.10f * b->tail_level * (y[1] - y[3] + 0.5f * y[2]);
 }
 
