+/* Headphone surround (WINE_HEADPHONE_SURROUND=1): a stereo output device is offered to
+ * Windows programs as 7.1, and each speaker channel of a multichannel stream is rendered for
+ * the two ears with a spherical-head model (C. P. Brown and R. O. Duda, "A structural model
+ * for binaural sound synthesis", 1998): an interaural time delay and a one-pole/one-zero head
+ * shadow filter per ear, plus a darker tone for speakers behind the listener. The audio unit
+ * then gets plain stereo float, so macOS does no downmix of its own. Off unless set. */
+#define BIN_HIST 256            /* input history per channel; covers the delay up to 192 kHz */
+#define BIN_MAX_CHANNELS 18
+
+struct binaural_chan
+{
+    BOOL lfe, rear;
+    float gain;
+    float delay[2];             /* samples, per ear (0 left, 1 right) */
+    float b0[2], b1[2], a1[2];  /* head shadow filter per ear */
+    float x1[2], y1[2], lp[2];
+};
+
+struct binaural
+{
+    UINT channels, bytes;
+    BOOL is_float;
+    float rear_k;
+    UINT pos;
+    struct binaural_chan ch[BIN_MAX_CHANNELS];
+    float hist[BIN_MAX_CHANNELS][BIN_HIST];
+};
+
+static BOOL headphone_surround(void)
+{
+    static int on = -1;
+    if(on < 0){
+        const char *env = getenv("WINE_HEADPHONE_SURROUND");
+        on = env && *env && *env != '0';
+        TRACE("headphone surround %s\n", on ? "on" : "off");
+    }
+    return on;
+}
