+static UINT device_channel_count(AudioDeviceID device, EDataFlow flow)
+{
+    AudioObjectPropertyAddress addr;
+    AudioBufferList *buffers;
+    UInt32 size;
+    UINT ret = 0;
+    int i;
+
+    addr.mSelector = kAudioDevicePropertyStreamConfiguration;
+    addr.mScope = get_scope(flow);
+    addr.mElement = 0;
+
+    if(AudioObjectGetPropertyDataSize(device, &addr, 0, NULL, &size) != noErr) return 0;
+    if(!(buffers = malloc(size))) return 0;
+    if(AudioObjectGetPropertyData(device, &addr, 0, NULL, &size, buffers) == noErr)
+        for(i = 0; i < buffers->mNumberBuffers; i++)
+            ret += buffers->mBuffers[i].mNumberChannels;
+    free(buffers);
+    return ret;
+}
+
+static DWORD get_channel_mask(unsigned int channels);
+
+/* Sample size in bytes for the formats headphone surround reads, 0 for others. */
+static UINT binaural_bytes(const WAVEFORMATEX *fmt, BOOL *is_float)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)fmt;
+    BOOL ext = fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE;
+
+    *is_float = fmt->wFormatTag == WAVE_FORMAT_IEEE_FLOAT ||
+                (ext && IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_IEEE_FLOAT));
+    if(*is_float) return fmt->wBitsPerSample == 32 ? 4 : 0;
+    if(fmt->wFormatTag != WAVE_FORMAT_PCM && !(ext && IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_PCM)))
+        return 0;
+    switch(fmt->wBitsPerSample){
+    case 16: return 2;
+    case 24: return 3;
+    case 32: return 4;
+    }
+    return 0;
+}
+
+/* Whether a render stream in this format on this device is played as headphone surround. */
+static BOOL binaural_wanted(EDataFlow flow, AudioDeviceID device, const WAVEFORMATEX *fmt)
+{
+    BOOL is_float;
+    UINT dev_channels;
+
+    if(flow != eRender || !headphone_surround()) return FALSE;
+    if(fmt->nChannels <= 2 || fmt->nChannels > BIN_MAX_CHANNELS) return FALSE;
+    if(!binaural_bytes(fmt, &is_float) || fmt->nBlockAlign != fmt->nChannels * binaural_bytes(fmt, &is_float))
+        return FALSE;
+    dev_channels = device_channel_count(device, flow);
+    return dev_channels > 0 && dev_channels <= 2;
+}
+
+static float binaural_azimuth(DWORD bit, DWORD mask)
+{
+    BOOL sides = (mask & (SPEAKER_SIDE_LEFT | SPEAKER_SIDE_RIGHT)) != 0;
+    BOOL backs = (mask & (SPEAKER_BACK_LEFT | SPEAKER_BACK_RIGHT)) != 0;
+
+    switch(bit){
+    case SPEAKER_FRONT_LEFT: case SPEAKER_TOP_FRONT_LEFT: return -30;
+    case SPEAKER_FRONT_RIGHT: case SPEAKER_TOP_FRONT_RIGHT: return 30;
+    case SPEAKER_FRONT_LEFT_OF_CENTER: return -15;
+    case SPEAKER_FRONT_RIGHT_OF_CENTER: return 15;
+    case SPEAKER_BACK_LEFT: case SPEAKER_TOP_BACK_LEFT: return sides ? -150 : -110;
+    case SPEAKER_BACK_RIGHT: case SPEAKER_TOP_BACK_RIGHT: return sides ? 150 : 110;
+    case SPEAKER_BACK_CENTER: case SPEAKER_TOP_BACK_CENTER: return 180;
+    case SPEAKER_SIDE_LEFT: return backs ? -90 : -110;
+    case SPEAKER_SIDE_RIGHT: return backs ? 90 : 110;
+    }
+    return 0;   /* front center, top center, top front center, unlisted channels */
+}
+
+static struct binaural *binaural_create(const WAVEFORMATEX *fmt)
+{
+    static const float head = 0.0875f, sound = 343.0f; /* head radius (m), speed of sound (m/s) */
+    struct binaural *b;
+    DWORD mask, bit = 1;
+    float fs = fmt->nSamplesPerSec, K = 2 * fs, beta = 2 * sound / head;
+    UINT c, e;
+
+    if(!(b = calloc(1, sizeof(*b)))) return NULL;
+    b->channels = fmt->nChannels;
+    b->bytes = binaural_bytes(fmt, &b->is_float);
+    b->rear_k = 1 - expf(-2 * M_PI * 3000 / fs);
+    mask = fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE ? ((const WAVEFORMATEXTENSIBLE *)fmt)->dwChannelMask
+                                                       : get_channel_mask(fmt->nChannels);
+
+    for(c = 0; c < b->channels; c++){
+        struct binaural_chan *ch = &b->ch[c];
+        DWORD this_bit = 0;
+        float az;
+
+        /* Windows orders a stream's channels by ascending speaker bit. */
+        while(bit && !(mask & bit)) bit <<= 1;
+        if(bit){ this_bit = bit; bit <<= 1; }
+
+        if(this_bit == SPEAKER_LOW_FREQUENCY){
+            ch->lfe = TRUE;
+            ch->gain = 0.5f;
+            continue;
+        }
+        az = binaural_azimuth(this_bit, mask);
+        ch->rear = fabsf(az) > 90;
+        ch->gain = 0.7f;
+        for(e = 0; e < 2; e++){
+            /* angle between the source and this ear (left ear at -90, right at +90 degrees) */
+            float theta = fabsf(remainderf(az - (e ? 90.0f : -90.0f), 360.0f));
+            float rad = theta * (float)M_PI / 180;
+            float alpha = 1.05f + 0.95f * cosf(theta / 150 * (float)M_PI);
+            float t = rad < M_PI / 2 ? -cosf(rad) : rad - (float)M_PI / 2;
+
+            ch->delay[e] = (1 + t) * head / sound * fs;
+            if(ch->delay[e] > BIN_HIST - 2) ch->delay[e] = BIN_HIST - 2;
+            ch->b0[e] = (alpha * K + beta) / (K + beta);
+            ch->b1[e] = (beta - alpha * K) / (K + beta);
+            ch->a1[e] = (beta - K) / (K + beta);
+        }
+        TRACE("channel %u: speaker 0x%x at %.0f degrees, delay %.1f/%.1f samples\n",
+              c, (unsigned int)this_bit, az, ch->delay[0], ch->delay[1]);
+    }
+    return b;
 }
 
+static float binaural_sample(const struct binaural *b, const BYTE *frame, UINT c)
+{
+    switch(b->bytes){
+    case 2: return ((const INT16 *)frame)[c] / 32768.0f;
+    case 3:
+    {
+        const BYTE *s = frame + 3 * c;
+        return (INT32)(((UINT32)s[0] << 8) | ((UINT32)s[1] << 16) | ((UINT32)s[2] << 24)) / 2147483648.0f;
+    }
+    case 4: return b->is_float ? ((const float *)frame)[c] : ((const INT32 *)frame)[c] / 2147483648.0f;
+    }
+    return 0;
+}
+
+/* One frame of the stream (NULL: silence) to one stereo float frame. */
+static void binaural_frame(struct binaural *b, const BYTE *frame, float *out)
+{
+    UINT c, e;
+
+    out[0] = out[1] = 0;
+    b->pos = (b->pos + 1) & (BIN_HIST - 1);
+    for(c = 0; c < b->channels; c++){
+        struct binaural_chan *ch = &b->ch[c];
+        float x = frame ? binaural_sample(b, frame, c) : 0;
+
+        b->hist[c][b->pos] = x;
+        if(ch->lfe){
+            out[0] += x * ch->gain;
+            out[1] += x * ch->gain;
+            continue;
+        }
+        for(e = 0; e < 2; e++){
+            UINT d = (UINT)ch->delay[e];
+            float frac = ch->delay[e] - d;
+            float s0 = b->hist[c][(b->pos - d) & (BIN_HIST - 1)];
+            float s1 = b->hist[c][(b->pos - d - 1) & (BIN_HIST - 1)];
+            float s = s0 + (s1 - s0) * frac;
+            float y = ch->b0[e] * s + ch->b1[e] * ch->x1[e] - ch->a1[e] * ch->y1[e];
+
+            ch->x1[e] = s;
+            ch->y1[e] = y;
+            if(ch->rear){
+                ch->lp[e] += b->rear_k * (y - ch->lp[e]);
+                y = ch->lp[e] + 0.5f * (y - ch->lp[e]);
+            }
+            out[e] += y * ch->gain;
+        }
+    }
+}
