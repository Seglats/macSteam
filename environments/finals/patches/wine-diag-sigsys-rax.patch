 extern LONG64 wine_diag_sigsys[2][4096];
+/* the same by full rax, for numbers outside the service tables (open addressing, 64 slots) */
+struct wine_diag_rax { ULONG64 rax; LONG64 count; };
+extern struct wine_diag_rax wine_diag_sigsys_rax[64];
+static inline void wine_diag_count_rax( ULONG64 rax )
+{
+    unsigned int i, slot = (unsigned int)((rax * 0x9e3779b97f4a7c15ull) >> 58);
+
+    if (!wine_diag_enabled) return;
+    for (i = 0; i < 64; i++, slot = (slot + 1) % 64)
+    {
+        ULONG64 seen = __atomic_load_n( &wine_diag_sigsys_rax[slot].rax, __ATOMIC_RELAXED );
+        if (seen == rax + 1 ||
+            (!seen && __atomic_compare_exchange_n( &wine_diag_sigsys_rax[slot].rax, &seen, rax + 1, 0,
+                                                   __ATOMIC_RELAXED, __ATOMIC_RELAXED )) ||
+            seen == rax + 1)
+        {
+            __atomic_fetch_add( &wine_diag_sigsys_rax[slot].count, 1, __ATOMIC_RELAXED );
+            return;
+        }
+    }
+}
