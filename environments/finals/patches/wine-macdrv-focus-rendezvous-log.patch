--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -1029,8 +1029,62 @@
 static NSString* const WineExternalQuitNotificationWinePrefixKey = @"WinePrefix";
 
 bool macdrv_err_on;
+bool macdrv_ui_on;
+
+/* C06: window/focus state for the stuck dump's "ui note 0" (via wine_diag_note).
+ * Updated on every transition; transitions also trace with WINEDEBUG=+macdrv. */
+static int      ui_app_active = -1;   /* -1 unknown, 0 inactive, 1 active */
+static uint64_t ui_app_since;
+static void*    ui_key_window;
+static uint64_t ui_key_since;
+
+uint64_t macdrv_ui_now_ns(void)
+{
+    return clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
+}
 
+static void ui_note_update(const char *why)
+{
+    char buf[160];
+    uint64_t now = macdrv_ui_now_ns();
+    int n;
 
+    n = snprintf(buf, sizeof(buf), "app %s",
+                 ui_app_active == 1 ? "active" : ui_app_active == 0 ? "inactive" : "unknown");
+    if (ui_app_active >= 0)
+        n += snprintf(buf + n, sizeof(buf) - n, " %.1f s", (now - ui_app_since) / 1e9);
+    n += snprintf(buf + n, sizeof(buf) - n, "; key win %p", ui_key_window);
+    if (ui_key_window)
+        snprintf(buf + n, sizeof(buf) - n, " %.1f s", (now - ui_key_since) / 1e9);
+    wine_diag_note(0, buf);
+    UI_LOG(@"%s -> %s", why, buf);
+}
+
+void macdrv_ui_note_app_active(int active)
+{
+    if (ui_app_active == active) return;
+    ui_app_active = active;
+    ui_app_since = macdrv_ui_now_ns();
+    ui_note_update(active ? "app became active" : "app resigned active");
+}
+
+void macdrv_ui_note_key_window(void *window)
+{
+    if (window)
+    {
+        if (ui_key_window == window) return;
+        ui_key_window = window;
+        ui_key_since = macdrv_ui_now_ns();
+        ui_note_update("window became key");
+    }
+    else if (ui_key_window)
+    {
+        ui_key_window = NULL;
+        ui_note_update("window resigned key");
+    }
+}
+
