+    wrapped = [wrapped copy];
     dispatch_sync(controller->requestsManipQueue, ^{
-        [controller->requests addObject:block];
+        [controller->requests addObject:wrapped];
     });
-    [block release];
+    [wrapped release];
     CFRunLoopSourceSignal(controller->requestSource);
     CFRunLoopWakeUp(CFRunLoopGetMain());
 }
@@ -4991,6 +5055,23 @@
     va_list args;
     va_start(args, format);
     LogErrorv(func, format, args);
+    va_end(args);
+}
+
+/***********************************************************************
+ *              LogTrace
+ */
+void LogTrace(const char* func, NSString* format, ...)
+{
+    va_list args;
+
+    va_start(args, format);
+    @autoreleasepool
+    {
+        NSString* message = [[NSString alloc] initWithFormat:format arguments:args];
+        fprintf(stderr, "trace:%s:%s", func, [message UTF8String]);
+        [message release];
+    }
     va_end(args);
 }
 
