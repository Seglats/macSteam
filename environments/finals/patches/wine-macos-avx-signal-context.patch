--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -357,6 +357,28 @@
 
 #define XState_sig(context)  NULL
 
+/* macOS signal contexts carry the AVX state when uc_mcsize says so (Rosetta delivers the AVX
+ * mcontext and applies changes made to it on return), but not in XSAVE layout: the upper
+ * halves of YMM0-15 sit 580 bytes after the FPU control word, after 4 reserved bytes and a
+ * 64-byte reserved block instead of the XSAVE header at 512. So they are copied into an XSAVE
+ * buffer in struct xcontext (save_context) and back (restore_context), not referenced in place
+ * like on Linux. Without this, exception contexts and suspended-thread contexts have no AVX
+ * state and continuing from an exception does not restore the YMM upper halves. */
+static inline M128A *YMMH_sig( const ucontext_t *context )
+{
+    if (context->uc_mcsize == sizeof(_STRUCT_MCONTEXT_AVX64) ||
+        context->uc_mcsize == sizeof(_STRUCT_MCONTEXT_AVX64_FULL) ||
+#ifdef _STRUCT_MCONTEXT_AVX512_64
+        context->uc_mcsize == sizeof(_STRUCT_MCONTEXT_AVX512_64) ||
+#endif
+        context->uc_mcsize == SIZEOF_STRUCT_MCONTEXT_AVX512_64_FULL)
+    {
+        return (M128A *)((char *)FPU_sig( context ) + offsetof( _STRUCT_X86_AVX_STATE64, __fpu_ymmh0 )
+                         - offsetof( _STRUCT_X86_AVX_STATE64, __fpu_fcw ));
+    }
+    return NULL;
+}
+
 #else
 #error You must define the signal context functions for your platform
 #endif
