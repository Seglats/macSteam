+/**********************************************************************
+ *		mac_gsbase_switching / mac_set_gsbase / mac_current_teb
+ *
+ * Keep the real GS base on the Windows TEB while Windows code runs, and on
+ * macOS's own thread data while Unix code runs, like Wine does on Linux with
+ * arch_prctl(2).  mac_set_gsbase() uses the machdep trap pthread itself uses
+ * (thread_fast_set_cthread_self64); like any syscall it only clobbers
+ * %rax/%rcx/%r11.  mac_current_teb() reads the TEB self-pointer through %gs,
+ * which yields the TEB whichever base is live, because the field is mirrored
+ * into the macOS thread data at thread start (init_syscall_frame).
+ * NtCurrentTeb() must not be used for that: it is pthread_getspecific() and
+ * needs the macOS base.  Cleared unless running under Rosetta (set
+ * MACFINALS_NO_GS_TEB to disable), so unsupported setups keep the old
+ * behaviour of never switching.
+ */
+int mac_gsbase_switching;
+#define MAC_GSBASE_TEB_MAGIC ((void *)(ULONG_PTR)0x47425357)  /* "GSBW" */
+
+static void mac_set_gsbase( void *base )
+{
+    __asm__ volatile ( "syscall" : : "a" (0x3000003L), "D" (base) : "rcx", "r11", "memory" );
+}
+
+static inline TEB *mac_current_teb(void)
+{
+    TEB *teb;
+    __asm__ volatile ( "movq %%gs:0x30,%0" : "=r" (teb) );
+    return teb;
+}
+#endif
+
