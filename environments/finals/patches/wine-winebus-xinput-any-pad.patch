 static inline struct xbox_device *impl_from_unix_device(struct unix_device *iface)
 {
     return CONTAINING_RECORD(iface, struct xbox_device, unix_device);
+}
+
+static BOOL sequoia_or_later(void);
+
+/* The device's Xbox 360 wired interface (class 255, subclass 93, protocol 1), found in the
+ * registry without opening the device: composite pads (8BitDo's "for PC" models add HID keyboard
+ * and mouse interfaces) have other interfaces in use by macOS, which USBDeviceOpen and
+ * SetConfiguration would disturb. Returns a retained interface service, or 0. */
+static io_service_t find_xinput_interface(io_object_t device)
+{
+    io_iterator_t iter;
+    io_service_t entry, found = 0;
+
+    if (IORegistryEntryCreateIterator(device, kIOServicePlane, kIORegistryIterateRecursively, &iter) != KERN_SUCCESS)
+        return 0;
+    while (!found && (entry = IOIteratorNext(iter)))
+    {
+        static const char *keys[3] = {"bInterfaceClass", "bInterfaceSubClass", "bInterfaceProtocol"};
+        static const int want[3] = {255, 93, 1};
+        int i, value;
+
+        for (i = 0; i < 3; i++)
+        {
+            CFStringRef key = CFStringCreateWithCString(NULL, keys[i], kCFStringEncodingUTF8);
+            CFTypeRef number = IORegistryEntryCreateCFProperty(entry, key, kCFAllocatorDefault, 0);
+            CFRelease(key);
+            value = -1;
+            if (number)
+            {
+                if (CFGetTypeID(number) == CFNumberGetTypeID()) CFNumberGetValue(number, kCFNumberIntType, &value);
+                CFRelease(number);
+            }
+            if (value != want[i]) break;
+        }
+        /* Only this device's own interfaces: a hub's subtree holds the devices behind it. */
+        if (i == 3)
+        {
+            io_registry_entry_t parent = 0;
+            if (IORegistryEntryGetParentEntry(entry, kIOServicePlane, &parent) == KERN_SUCCESS)
+            {
+                if (IOObjectIsEqualTo(parent, device)) found = entry;
+                IOObjectRelease(parent);
+            }
+        }
+        if (!found) IOObjectRelease(entry);
+    }
+    IOObjectRelease(iter);
+    return found;
 }
 
 static struct xbox_device *find_device_from_io_object(io_object_t object)
@@ -290,16 +340,22 @@
