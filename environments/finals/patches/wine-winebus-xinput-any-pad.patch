@@ -446,8 +473,58 @@
 
     ret = (*private->interface)->USBInterfaceOpen(private->interface);
     if (ret != kIOReturnSuccess)
+    {
+        /* macOS Steam's own controller support opens wired Xbox-protocol pads exclusively. */
+        WARN("cannot open the pad's Xbox 360 interface (%#x)%s\n", ret,
+             ret == kIOReturnExclusiveAccess ? ": another program holds it (Steam's controller support?)" : "");
+        (*private->interface)->Release(private->interface);
+        private->interface = NULL;
         return STATUS_UNSUCCESSFUL;
+    }
 
+    /* The interrupt pipes, rather than assuming the IN pipe is 1. */
+    private->in_pipe = private->out_pipe = 0;
+    (*private->interface)->GetNumEndpoints(private->interface, &endpoints);
+    for (pipe = 1; pipe <= endpoints; pipe++)
+    {
+        UInt8 direction, number, type, interval;
+        UInt16 max_packet;
+
+        if ((*private->interface)->GetPipeProperties(private->interface, pipe, &direction, &number,
+                                                     &type, &max_packet, &interval) != kIOReturnSuccess)
+            continue;
+        if (type != kUSBInterrupt) continue;
+        if (direction == kUSBIn && !private->in_pipe) private->in_pipe = pipe;
+        if (direction == kUSBOut && !private->out_pipe) private->out_pipe = pipe;
+        TRACE("pipe %u: endpoint %u %s, max packet %u, interval %u\n", pipe, number,
+              direction == kUSBIn ? "in" : "out", max_packet, interval);
+    }
+    if (!private->in_pipe)
+    {
+        WARN("no interrupt IN pipe on the pad's Xbox 360 interface\n");
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    /* What Windows' XUSB driver and Linux's xpad send first: a vendor control read many
+     * non-Microsoft pads wait for before they send input, then the player-1 LED command. */
+    {
+        UInt8 data[20];
+        IOUSBDevRequest request =
+        {
+            .bmRequestType = USBmakebmRequestType(kUSBIn, kUSBVendor, kUSBInterface),
+            .bRequest = 0x01, .wValue = 0x0100, .wIndex = 0, .wLength = sizeof(data), .pData = data,
+        };
+        static UInt8 led[3] = {0x01, 0x03, 0x02};
+
+        ret = (*private->interface)->ControlRequest(private->interface, 0, &request);
+        TRACE("start-up control read %#x, %u bytes\n", ret, (unsigned)request.wLenDone);
+        if (private->out_pipe)
+        {
+            ret = (*private->interface)->WritePipe(private->interface, private->out_pipe, led, sizeof(led));
+            TRACE("player LED %#x\n", ret);
+        }
+    }
+
     ret = (*private->interface)->CreateInterfaceAsyncEventSource(private->interface, &private->source);
     if (ret != kIOReturnSuccess)
         return STATUS_UNSUCCESSFUL;
@@ -456,7 +533,7 @@
 
