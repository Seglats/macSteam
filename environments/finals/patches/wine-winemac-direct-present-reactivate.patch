+
+/* Coming back to the app: AppKit makes the Wine window key again some time after activation
+ * (Recall measured about a second), so the check runs at activation and 0.3 s and 1 s later. */
+static void direct_recheck(void)
+{
+    for (NSWindow *window in [NSApp windows])
+        if ([window isKindOfClass:[WineWindow class]] && [window isVisible])
+            macdrv_direct_update((WineWindow *)window, "app active");
+}
+
+static void direct_observe(void)
+{
+    static BOOL observing;
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+    void (^later)(NSNotification *) = ^(NSNotification *note) {
+        direct_recheck();
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ direct_recheck(); });
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ direct_recheck(); });
+    };
+
+    if (observing) return;
+    observing = YES;
+    [center addObserverForName:NSApplicationDidBecomeActiveNotification object:nil queue:[NSOperationQueue mainQueue] usingBlock:later];
+    [center addObserverForName:NSApplicationDidUnhideNotification object:nil queue:[NSOperationQueue mainQueue] usingBlock:later];
 }
 
