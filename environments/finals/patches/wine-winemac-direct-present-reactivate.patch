+/* Why a covering window is not presented directly, logged once per change. */
+static void direct_waiting(WineWindow *window, const char *reason)
+{
+    static WineWindow *last_window;
+    static const char *last_reason;
+
+    if (window == last_window && reason == last_reason) return;
+    last_window = window;
+    last_reason = reason;
+    if (reason) ERR(@"direct presentation waiting for window %p: %s\n", window, reason);
 }
 
