+/* WINEMAC_METAL_CAPTURE=<folder> (diagnostics; Metal only inserts its capture layer when
+ * MTL_CAPTURE_ENABLED=1 is set when the process starts): Control-Option-G saves all the
+ * Metal work of this process for WINEMAC_METAL_CAPTURE_MS (default 150 ms) as
+ * <folder>/capture-<date>.gputrace, to open in Xcode.  No debugger is involved.  Beeps
+ * when the file is written or the capture failed. */
+static BOOL handle_metal_capture_key(NSEvent* event)
+{
+    static const NSEventModifierFlags mask = NSEventModifierFlagControl | NSEventModifierFlagOption |
+                                             NSEventModifierFlagShift | NSEventModifierFlagCommand;
+    static BOOL checked;
+    static NSString* folder;
+    static long duration_ms = 150;
+    MTLCaptureManager* manager;
+    MTLCaptureDescriptor* descriptor;
+    NSDateFormatter* formatter;
+    NSString* path;
+    NSError* error = nil;
+
+    if (!checked)
+    {
+        const char* value = getenv("WINEMAC_METAL_CAPTURE");
+        const char* ms = getenv("WINEMAC_METAL_CAPTURE_MS");
+        checked = TRUE;
+        if (value && *value) folder = [[NSString alloc] initWithUTF8String:value];
+        if (ms && atol(ms) > 0) duration_ms = atol(ms);
+    }
+    if (!folder || event.keyCode != kVK_ANSI_G ||
+        (event.modifierFlags & mask) != (NSEventModifierFlagControl | NSEventModifierFlagOption))
+        return FALSE;
+    if (event.isARepeat) return TRUE;
+
+    manager = [MTLCaptureManager sharedCaptureManager];
+    if (manager.isCapturing) return TRUE;
+    if (![manager supportsDestination:MTLCaptureDestinationGPUTraceDocument])
+    {
+        ERR(@"Metal capture unavailable: MTL_CAPTURE_ENABLED=1 was not set at process start\n");
+        NSBeep();
+        return TRUE;
+    }
+
+    formatter = [[[NSDateFormatter alloc] init] autorelease];
+    formatter.dateFormat = @"yyyyMMdd-HHmmss";
+    path = [folder stringByAppendingPathComponent:[NSString stringWithFormat:@"capture-%@.gputrace",
+                                                   [formatter stringFromDate:[NSDate date]]]];
+    descriptor = [[[MTLCaptureDescriptor alloc] init] autorelease];
+    descriptor.captureObject = [[MTLCopyAllDevices() autorelease] firstObject];
+    descriptor.destination = MTLCaptureDestinationGPUTraceDocument;
+    descriptor.outputURL = [NSURL fileURLWithPath:path];
+    if (![manager startCaptureWithDescriptor:descriptor error:&error])
+    {
+        ERR(@"Metal capture failed to start: %@\n", error);
+        NSBeep();
+        return TRUE;
+    }
+    ERR(@"Metal capture started for %ld ms: %@\n", duration_ms, path);
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, duration_ms * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+        [[MTLCaptureManager sharedCaptureManager] stopCapture];
+        ERR(@"Metal capture written\n");
+        NSBeep();
+    });
+    return TRUE;
 }
 
 
