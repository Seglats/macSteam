+/* Per-frame record for <prefix>-frames-<pid>.csv (2026-11-13), to find where a frame that took
+ * a refresh longer than its neighbours to reach the display lost the time: requested/acquired
+ * (nextDrawable), handed = when D3DMetal's present of the drawable ran (the command buffer was
+ * scheduled), target = the time asked for with presentAtTime:, presented = on the display (0 =
+ * never shown). Plus the layer settings D3DMetal chose. Written by the per-second report, so
+ * nothing but a memory copy happens per frame. */
+#define PRESENT_RING 8192
+static struct macdrv_present_frame present_ring[PRESENT_RING];
+static unsigned int present_ring_count, present_ring_lost;
+static FILE *present_frames_file;
+static double present_frames_t0;
 
+void macdrv_present_frame(const struct macdrv_present_frame *frame)
+{
+    os_unfair_lock_lock(&present_lock);
+    if (present_ring_count < PRESENT_RING) present_ring[present_ring_count++] = *frame;
+    else present_ring_lost++;
+    os_unfair_lock_unlock(&present_lock);
+}
+
+static void macdrv_present_frames_flush(void)
+{
+    static struct macdrv_present_frame frames[PRESENT_RING];
+    unsigned int count, lost, i;
+    const char *prefix;
+
+    os_unfair_lock_lock(&present_lock);
+    count = present_ring_count;
+    lost = present_ring_lost;
+    memcpy(frames, present_ring, count * sizeof(frames[0]));
+    present_ring_count = present_ring_lost = 0;
+    os_unfair_lock_unlock(&present_lock);
+    if (!count) return;
+    if (!present_frames_file)
+    {
+        char path[PATH_MAX];
+
+        /* Opened at the first frame, so processes that never draw leave no file. */
+        if (!(prefix = getenv("WINEMAC_INPUT_STATS")) ||
+            snprintf(path, sizeof(path), "%s-frames-%d.csv", prefix, getpid()) >= sizeof(path) ||
+            !(present_frames_file = fopen(path, "a")))
+            return;
+        present_frames_t0 = frames[0].requested;
+        fprintf(present_frames_file, "# t0 %.6f (CACurrentMediaTime s); times in ms after t0, presented -1 = never shown\n"
+                "requested,acquired,handed,target,presented,how,sync,transaction,drawables,width,height\n",
+                present_frames_t0);
+    }
+#define REL(t) ((t) > 0 ? ((t) - present_frames_t0) * 1000 : -1.0)
+    for (i = 0; i < count; i++)
+        fprintf(present_frames_file, "%.3f,%.3f,%.3f,%.3f,%.3f,%c,%u,%u,%u,%u,%u\n",
+                REL(frames[i].requested), REL(frames[i].acquired), REL(frames[i].handed), REL(frames[i].target),
+                REL(frames[i].presented), frames[i].how, frames[i].sync, frames[i].transaction,
+                frames[i].drawables, frames[i].width, frames[i].height);
+#undef REL
+    if (lost) fprintf(present_frames_file, "# %u frames lost (ring full)\n", lost);
+    fflush(present_frames_file);
+}
