+/* WINEMAC_INPUT_STATS per-frame file: when D3DMetal's present of a drawable ran. The drawable
+ * gets a subclass of its own class (as key-value observing does) whose present methods note the
+ * time and call the original; -class still answers the original class. Only with the stats on. */
+struct present_timing
+{
+    double handed, target;
+    char how;
+};
+static char present_timing_key;
+
+static void present_timing_mark(id drawable, char how, double target)
+{
+    NSMutableData *data = objc_getAssociatedObject(drawable, &present_timing_key);
+    struct present_timing *t = data.mutableBytes;
+
+    if (t && !t->handed)
+    {
+        t->handed = CACurrentMediaTime();
+        t->target = target;
+        t->how = how;
+    }
+}
+
+static IMP present_timing_super(id self, SEL cmd)
+{
+    return class_getMethodImplementation(class_getSuperclass(object_getClass(self)), cmd);
+}
+
+static void present_timing_present(id self, SEL cmd)
+{
+    present_timing_mark(self, 'p', 0);
+    ((void (*)(id, SEL))present_timing_super(self, cmd))(self, cmd);
+}
+
+static void present_timing_present_at(id self, SEL cmd, CFTimeInterval when)
+{
+    present_timing_mark(self, 't', when);
+    ((void (*)(id, SEL, CFTimeInterval))present_timing_super(self, cmd))(self, cmd, when);
+}
+
+static void present_timing_present_after(id self, SEL cmd, CFTimeInterval duration)
+{
+    present_timing_mark(self, 'm', 0);
+    ((void (*)(id, SEL, CFTimeInterval))present_timing_super(self, cmd))(self, cmd, duration);
+}
+
+static Class present_timing_class(id self, SEL cmd)
+{
+    return class_getSuperclass(object_getClass(self));
+}
+
+static Class present_timing_subclass(Class base)
+{
+    static os_unfair_lock lock = OS_UNFAIR_LOCK_INIT;
+    static Class last_base, last_sub;
+    char name[256];
+    Class sub;
+
+    os_unfair_lock_lock(&lock);
+    if (base == last_base)
+    {
+        sub = last_sub;
+        os_unfair_lock_unlock(&lock);
+        return sub;
+    }
+    snprintf(name, sizeof(name), "WinePresentTimed_%s", class_getName(base));
+    if (!(sub = objc_getClass(name)) && (sub = objc_allocateClassPair(base, name, 0)))
+    {
+        class_addMethod(sub, @selector(present), (IMP)present_timing_present, "v@:");
+        class_addMethod(sub, @selector(presentAtTime:), (IMP)present_timing_present_at, "v@:d");
+        class_addMethod(sub, @selector(presentAfterMinimumDuration:), (IMP)present_timing_present_after, "v@:d");
+        class_addMethod(sub, @selector(class), (IMP)present_timing_class, "#@:");
+        objc_registerClassPair(sub);
+        ERR(@"timing presents of %s drawables for the per-frame file\n", class_getName(base));
+    }
+    last_base = base;
+    last_sub = sub;
+    os_unfair_lock_unlock(&lock);
+    return sub;
+}
