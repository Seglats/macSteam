+/* Present timing of the D3DMetal picture, with WINEMAC_INPUT_STATS (2026-11-12). WineMetalLayer
+ * puts a presented handler on every drawable the game takes (d3dmetal_objc.m); Core Animation
+ * reports when that frame reached the display, or 0 if it never did (replaced before a refresh).
+ * The time between two frames reaching the display is how long the first stayed on screen: on a
+ * 160 Hz display 6.25 ms, 12.5 ms for a frame held over a refresh, less than 6.25 ms only when the
+ * display path did not wait for a refresh. Counted per second into present_* fields of the input
+ * report: frames shown, frames never shown, and those intervals in buckets with upper edges
+ * 4, 5.5, 7, 9, 11, 13.5, 17, 25 ms and a last open one. Costs one block per frame. */
+int macdrv_present_stats_on;
+static os_unfair_lock present_lock = OS_UNFAIR_LOCK_INIT;
+static const double present_edges_ms[] = { 4, 5.5, 7, 9, 11, 13.5, 17, 25 };
+#define PRESENT_BUCKETS (sizeof(present_edges_ms) / sizeof(present_edges_ms[0]) + 1)
+static struct
+{
+    unsigned long long shown, dropped, buckets[PRESENT_BUCKETS];
+    double sum_ms, max_ms;
+} present_stats;
+static double present_last;
 
+void macdrv_present_record(double presented)
+{
+    os_unfair_lock_lock(&present_lock);
+    if (presented <= 0)
+        present_stats.dropped++;
+    else
+    {
+        present_stats.shown++;
+        if (present_last > 0 && presented > present_last)
+        {
+            double ms = (presented - present_last) * 1000;
+            unsigned int i = 0;
+
+            while (i < PRESENT_BUCKETS - 1 && ms >= present_edges_ms[i]) i++;
+            present_stats.buckets[i]++;
+            present_stats.sum_ms += ms;
+            if (ms > present_stats.max_ms) present_stats.max_ms = ms;
+        }
+        present_last = presented;
+    }
+    os_unfair_lock_unlock(&present_lock);
+}
+
+static void macdrv_present_take(char *out, size_t size)
+{
+    __typeof__(present_stats) p;
+    unsigned long long intervals = 0;
+    unsigned int i;
+    int used;
+
+    os_unfair_lock_lock(&present_lock);
+    p = present_stats;
+    memset(&present_stats, 0, sizeof(present_stats));
+    os_unfair_lock_unlock(&present_lock);
+    out[0] = 0;
+    if (!macdrv_present_stats_on) return;
+    for (i = 0; i < PRESENT_BUCKETS; i++) intervals += p.buckets[i];
+    used = snprintf(out, size, ",\"present_shown\":%llu,\"present_dropped\":%llu,\"present_ms_avg\":%.3f,"
+                    "\"present_ms_max\":%.3f,\"present_hist\":[", p.shown, p.dropped,
+                    intervals ? p.sum_ms / intervals : 0.0, p.max_ms);
+    for (i = 0; i < PRESENT_BUCKETS && used > 0 && used < (int)size; i++)
+        used += snprintf(out + used, size - used, "%s%llu", i ? "," : "", p.buckets[i]);
+    if (used > 0 && used < (int)size - 1) strcat(out, "]");
+    else out[0] = 0;
+}
