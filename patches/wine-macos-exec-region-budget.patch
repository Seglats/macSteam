+
+    server_enter_uninterrupted_section( &regions_mutex, &sigset );
+    for (i = seen; i < count; i++)
+        if (regions[i].start <= (char *)start && (char *)end <= regions[i].end) break;
+    add = i == count && count < ARRAY_SIZE(regions);
