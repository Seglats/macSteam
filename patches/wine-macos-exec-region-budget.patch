+ * protection changes: the reserved areas take the first entries and cover most memory.
  * virtual_mutex must not be held: the first call may dlopen, and libd3dshared's locking
- * is unknown.  There is no unregister; registering a range again is harmless.
+ * is unknown.
  */
 void mac_register_exec_region( void *start, void *end )
 {
+    static struct { char *start, *end; } regions[1024];
+    static pthread_mutex_t regions_mutex = PTHREAD_MUTEX_INITIALIZER;
+    static LONG count;
+    static BOOL full;
+    sigset_t sigset;
