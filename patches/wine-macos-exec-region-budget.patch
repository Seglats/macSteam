+/***********************************************************************
+ *           virtual_mac_register_reserved_areas
+ *
+ * Register the reserved areas whole: only Windows memory lands in them, and they stay
+ * reserved when it is freed, so native code can never appear there.
+ */
+void virtual_mac_register_reserved_areas(void)
+{
+    struct reserved_area *area;
+    struct { void *start, *end; } ranges[16];
+    unsigned int i, count = 0;
+    sigset_t sigset;
+
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    LIST_FOR_EACH_ENTRY( area, &reserved_areas, struct reserved_area, entry )
+    {
+        if (count == ARRAY_SIZE(ranges)) break;
+        ranges[count].start = area->base;
+        ranges[count++].end = (char *)area->base + area->size;
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    for (i = 0; i < count; i++) mac_register_exec_region( ranges[i].start, ranges[i].end );
+}
 #endif
 
 
