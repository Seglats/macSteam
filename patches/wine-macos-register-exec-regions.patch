+/***********************************************************************
+ *           mac_register_exec_region
+ *
+ * Register Windows executable memory that did not come through the PE loader.
+ * virtual_mutex must not be held: the first call may dlopen, and libd3dshared's locking
+ * is unknown.  There is no unregister; registering a range again is harmless.
+ */
+void mac_register_exec_region( void *start, void *end )
+{
+    pthread_once( &non_native_init_once, &init_non_native_support );
+    if (mac_exec_regions_enabled)
+    {
+        TRACE( "Marking non_native_code_region: %p-%p\n", start, end );
+        register_non_native_code_region( start, end );
+    }
 }
 
