 /***********************************************************************
+ *           is_mac_exec_region_view
+ *
+ * Whether executable memory in this view is Windows code to register with
+ * mac_register_exec_region.  As with the PE loader's registration, Wine's builtin modules
+ * are left out, and so are system views.  virtual_mutex must be held by caller.
+ */
+static BOOL is_mac_exec_region_view( const struct file_view *view )
+{
+    struct builtin_module *builtin;
+
+    if (view->protect & VPROT_SYSTEM) return FALSE;
+    if (view->protect & SEC_IMAGE)
+    {
+        LIST_FOR_EACH_ENTRY( builtin, &builtin_modules, struct builtin_module, entry )
+            if (builtin->module == view->base) return FALSE;
+    }
+    return TRUE;
+}
+#endif
